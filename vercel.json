{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": [
          "app.py",
          "hub_moveset_converter.py",
          "luau_moveset_mind.py",
          "static/**",
          "*.html",
          "*.css",
          "*.js",
          "*.png"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
